{
  "manifest_version": 3,
  "name": "EngiMate",
  "description": "Engineering toolkit for EE/CE students — unit converter, resistor calculator, truth tables, datasheet finder, formula saver & number converter.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "EngiMate — Engineering Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
